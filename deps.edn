{:paths ["src"]
 ;; langgraph-clj (kotoba-lang/langgraph) brings langchain (kotoba-lang/
 ;; langchain) transitively via its own deps.edn -- both zero-/single-dep,
 ;; all .cljc, portable to JVM / SCI / ClojureScript / GraalVM. Standalone
 ;; public git coordinate (this repo is a standalone fork target, not
 ;; monorepo-internal), the SAME shape `cloud-itonami-isco-3521` (this
 ;; fleet's closest domain analog) uses -- deliberately not the
 ;; monorepo-internal `:local/root`-based shape `cloud-itonami-isic-6130`/
 ;; `-6190` use, since this repo has no reason to assume a sibling
 ;; monorepo checkout exists.
 :deps {io.github.kotoba-lang/langgraph
        {:git/sha "5b4e5e70837b849b14b6a5800894e3be202ad5fa"}}
 :aliases
 {;; clojure -M:dev:run  -> drive the demo through one WireActor
  :run {:main-opts ["-m" "newswire.sim"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
